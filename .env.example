# 📧 Gmail SMTP Configuration for Email Verification
# Get App Password from: https://myaccount.google.com/apppasswords
# Steps:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate App Password (select "Mail" + "Windows Computer")
# 3. Copy the 16-character password below

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: Customize sender name
EMAIL_FROM=Antika Store <noreply@antika-store.com>

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.example.mongodb.net/antika_store?retryWrites=true&w=majority

# Server
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Admin auth (required for /admin.html login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_TOKEN_TTL=8h
